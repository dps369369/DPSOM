rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isForbiddenSeedId(id) {
      return id == 'website-development' ||
             id == 'research-assistant-deep-synthesis' ||
             id == 'professional-writing-editorial-strategy' ||
             id == 'learning-assistant-concept-mastery' ||
             id == 'personal-planning-executive-strategy';
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if !isForbiddenSeedId(categoryId);
      allow delete: if true;
    }

    match /category_usage/{usageId} {
      allow read, write: if true;
    }

    match /drafts/{draftId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
